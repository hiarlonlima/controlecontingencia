# Copie este arquivo para .env (ou .env.local) e preencha com os valores
# do seu projeto Supabase. SEM ESSAS DUAS VARS, a app cai automaticamente
# para localStorage (modo local sem sync entre dispositivos).
#
# Onde encontrar:
#   Supabase Dashboard → Project Settings → API
#       Project URL  →  VITE_SUPABASE_URL
#       anon public  →  VITE_SUPABASE_ANON_KEY
#
# Importante: a chave "anon public" é segura no client (RLS protege os dados).
# NUNCA exponha a chave "service_role" — ela bypassa o RLS.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
